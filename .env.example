# Aether — environment variables
# Copy to a local secrets/runtime.env only on your own machine. Never commit real values.
# The hosted app injects DATABASE_URL and XAI_API_KEY automatically.
# LIVE TRADING STAYS DISABLED. Do not put keys, emails, or names in VITE_ variables.

# --- Core ---
TRADING_MODE=PAPER
ENABLE_LIVE_TRADING=false
LIVE_EXECUTION_UNLOCK=

# --- Database (optional locally; preview uses embedded PGLite) ---
DATABASE_URL=

# --- LLM research (injected in this environment; do not paste into git) ---
XAI_API_KEY=

# --- Market data (optional; public endpoints work without keys) ---
COINGECKO_API_KEY=
COINGECKO_BASE_URL=https://api.coingecko.com

# --- Social ---
# X API v2 bearer token. Recent search requires a paid X API plan.
# Paste the bearer EXACTLY as the X portal shows it (keep %2F / %2B / %3D).
X_BEARER_TOKEN=
X_API_KEY=
X_API_SECRET=

# --- Private digest (never expose on the public desk; gitignored secrets/ only) ---
DIGEST_TO=

# --- Paper ---
PAPER_STARTING_EQUITY_USD=10000
