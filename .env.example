# Aether — environment variables
# Copy to a local .env only on your own machine. Never commit real values.
# The hosted app injects DATABASE_URL and XAI_API_KEY automatically.
# LIVE TRADING STAYS DISABLED unless every live gate in docs/TRADING.md is satisfied.

# --- Core ---
# TRADING_MODE=PAPER|LIVE   (default PAPER; LIVE is ignored unless ENABLE_LIVE_TRADING=true)
TRADING_MODE=PAPER
ENABLE_LIVE_TRADING=false
LIVE_EXECUTION_UNLOCK=
KILL_SWITCH=false

# --- Database (optional locally; preview uses embedded PGLite) ---
DATABASE_URL=

# --- LLM research (injected in this environment; do not paste into git) ---
XAI_API_KEY=

# --- Market data (optional; public endpoints work without keys) ---
COINGECKO_API_KEY=
COINGECKO_BASE_URL=https://api.coingecko.com
COINMARKETCAP_API_KEY=
DEXSCREENER_API_KEY=

# --- On-chain RPC / indexers (optional, used when present) ---
ALCHEMY_API_KEY=
QUICKNODE_URL=
HELIUS_API_KEY=
ETHERSCAN_API_KEY=
BSCSCAN_API_KEY=
BASESCAN_API_KEY=
ARBISCAN_API_KEY=

# --- Social ---
# X API v2 bearer token. Recent search requires a paid X API plan.
X_BEARER_TOKEN=
X_API_KEY=
X_API_SECRET=

# --- News (optional paid upgrades) ---
CRYPTOPANIC_API_KEY=
NEWSAPI_KEY=

# --- Alerts ---
DISCORD_WEBHOOK_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
ALERT_EMAIL_FROM=
SMTP_URL=

# --- Exchange live trading (WITHDRAWALS MUST BE DISABLED) ---
# Do not set these until you have read docs/TRADING.md and docs/SECURITY.md.
BINANCE_API_KEY=
BINANCE_API_SECRET=
COINBASE_API_KEY=
COINBASE_API_SECRET=

# --- Paper ---
PAPER_STARTING_EQUITY_USD=10000
